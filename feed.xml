---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" />
  <link href="{{ '/' | absolute_url }}" />
  <id>{{ '/' | absolute_url }}</id>
  {% assign blog_posts = site.posts | where_exp: "post", "post.path contains '_posts/blog/'" %}
  {% if blog_posts.first %}
  <updated>{{ blog_posts.first.date | date_to_xmlschema }}</updated>
  {% else %}
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  {% endif %}
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
  </author>
  {% for post in blog_posts limit: 20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" />
    <id>{{ post.url | absolute_url }}</id>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <summary type="html">{{ post.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
